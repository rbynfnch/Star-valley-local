# Copy to .env.local and fill in. NEVER commit real values. Variables without NEXT_PUBLIC_ are server-only.

# --- Site / tenant -------------------------------------------------------------------------------
# The tenant comes from the request Host header via the tenant_domains table (seed registers
# star-valley.localhost). There is deliberately NO site-URL variable: the origin is derived per request.
# DEVELOPMENT ONLY: tenant to use for hosts that are not registered (e.g. plain localhost). Ignored in production,
# where an unknown host is a 404.
DEFAULT_TENANT_SLUG=star-valley
# DEVELOPMENT ONLY: render from a local snapshot instead of Supabase (`npm run fixtures` after seeding a local DB).
# Refused in production.
# SVL_DATA_SOURCE=fixtures

# --- Supabase ------------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses RLS. Used by: /api/track, /api/quote, /api/submit, /api/subscribe, claim flow,
# CSV import, Stripe webhook. Never import it from client components.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare Turnstile (captcha for quote requests, submissions, newsletter signup) -------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Backend jobs ----------------------------------------------------------------------------------
# Shared secret the scheduler sends to the notification-worker route (see docs/NOTIFICATIONS.md).
CRON_SECRET=

# --- Analytics ingest ----------------------------------------------------------------------------
# Salt for hashing visitor session ids in tracking_events (no IPs are stored). Rotate periodically.
TRACKING_SESSION_SALT=

# --- Stripe (Payment Links first) ------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email: Postmark, two SEPARATE servers on two SEPARATE sending subdomains --------------------------------
# Residents never get business mail and business owners never get consumer mail. One Postmark server per audience:
#   business server -> transactional stream ("outbound"): service notices to owners (verification, grace, renewals)
#                      and internal staff alerts, sent from e.g. business@biz.example.com
#   consumer server -> broadcast stream: the opt-in resident newsletter, sent from e.g. hello@mail.example.com
# Cold outreach to businesses that have NOT opted in does NOT go through Postmark (its policy forbids it, and a
# suspension would stop the service notices). That uses a separate provider and domain, chosen before V3.
POSTMARK_BUSINESS_SERVER_TOKEN=
POSTMARK_BUSINESS_STREAM=outbound
POSTMARK_CONSUMER_SERVER_TOKEN=
POSTMARK_CONSUMER_STREAM=broadcast
# Basic-auth credentials Postmark uses when calling our bounce / spam-complaint / unsubscribe webhook
POSTMARK_WEBHOOK_USER=
POSTMARK_WEBHOOK_PASSWORD=
EMAIL_FROM_CONSUMER="Star Valley Local <hello@mail.example.com>"
EMAIL_FROM_BUSINESS="Star Valley Local Business <business@biz.example.com>"
# Required in every marketing email footer (CAN-SPAM). Also stored per tenant in tenants.mailing_address.
EMAIL_PHYSICAL_ADDRESS=

# --- SMS (verification codes ONLY; no marketing SMS) ------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
