# Copy to .env.local and fill in. NEVER commit real values. Variables without NEXT_PUBLIC_ are server-only.

# --- Site / tenant -------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://star-valley.localhost:3000
# Dev fallback when the request host is not in tenant_domains
DEFAULT_TENANT_SLUG=star-valley

# --- Supabase ------------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses RLS. Used by: /api/track, /api/quote, /api/submit, /api/subscribe, claim flow,
# CSV import, Stripe webhook. Never import it from client components.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare Turnstile (captcha for quote requests, submissions, newsletter signup) -------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Backend jobs ----------------------------------------------------------------------------------
# Shared secret the scheduler sends to the notification-worker route (see docs/NOTIFICATIONS.md).
CRON_SECRET=

# --- Analytics ingest ----------------------------------------------------------------------------
# Salt for hashing visitor session ids in tracking_events (no IPs are stored). Rotate periodically.
TRACKING_SESSION_SALT=

# --- Stripe (Payment Links first) ------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email: two SEPARATE sending subdomains (residents never get business outreach, and vice versa) --
# Provider: Resend or Postmark (decide before slice 4; fill the one you choose).
EMAIL_PROVIDER=resend
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
EMAIL_FROM_CONSUMER="Star Valley Local <hello@mail.example.com>"
EMAIL_FROM_BUSINESS="Star Valley Local Business <business@biz.example.com>"
# Required in every marketing email footer (CAN-SPAM). Also stored per tenant in tenants.mailing_address.
EMAIL_PHYSICAL_ADDRESS=

# --- SMS (verification codes ONLY; no marketing SMS) ------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
